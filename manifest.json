{
  "manifest_version": 3,
  "name": "Torrent Highlighter",
  "version": "1.0.0",
  "description": "Multi-source torrent launcher, automatic pagination merging, size and seeder sorting, subtitle search, and release tag highlighting.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "omnibox": {
    "keyword": "tor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.torrentsbay.org/*",
        "*://limetorrents.torrentsbay.org/*",
        "*://*.1337x.tube/*",
        "*://1337x.tube/*",
        "*://*.1337x.to/*",
        "*://nyaa.si/*",
        "*://*.nyaa.si/*"
      ],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_end"
    }
  ]
}
